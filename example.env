# Absolute path to your Obsidian vault directory (required).
# In Docker this is used as the host-side volume source — the vault is
# mounted read-write at /vault inside the container.
OBSIDIAN_VAULT=/path/to/your/obsidian/vault

# Port the server listens on (default: 6002).
# Also controls the Docker port mapping when using docker-compose.
# PORT=6002

# Path to the JSON file that stores projects and preferences (default: ./data.json).
# In Docker the file is bind-mounted from the project root to /app/data.json,
# so this only needs changing if you move the file.
# DATA_FILE=./data.json
